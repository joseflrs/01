++	model = "FriendlyElec NanoPi M4V2";
++	compatible = "friendlyarm,nanopi-m4", "rockchip,rk3399";
++
++	vdd_5v: vdd-5v {
++		compatible = "regulator-fixed";
++		regulator-name = "vdd_5v";
++		regulator-always-on;
++		regulator-boot-on;
++	};
++
++	vcc5v0_core: vcc5v0-core {
++		compatible = "regulator-fixed";
++		regulator-name = "vcc5v0_core";
