From 74dba4c5d79d5e1351416546d1899e4066695503 Mon Sep 17 00:00:00 2001
From: Balsam CHIHI <balsam.chihi@moment.tech>
Date: Mon, 28 Sep 2026 11:43:44 +0200
Subject: [PATCH 1/2] gnu-efi: fix build on modern toolchains

This resolves build failures on x86_64 targets caused by recent host
toolchain bumps in OpenWrt main:

1. Use PKG_DT_RELR:=0 to opt out of pack-relative relocations, preventing
   objcopy from failing to convert ELF shared objects to PE/COFF.
2. Add a patch to replace the deprecated objcopy `$(FORMAT)` flag with
   `--output-target efi-app-$(ARCH)` in Make.rules to satisfy
   Binutils >= 2.38 strictness.

Signed-off-by: Balsam CHIHI <balsam.chihi@moment.tech>
---
 libs/gnu-efi/Makefile                          |  4 +++-
 .../001-fix-objcopy-output-target.patch        | 18 ++++++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)
 create mode 100644 libs/gnu-efi/patches/001-fix-objcopy-output-target.patch

diff --git a/libs/gnu-efi/Makefile b/libs/gnu-efi/Makefile
index a197b2db28faa..9960a719302ab 100644
--- a/libs/gnu-efi/Makefile
+++ b/libs/gnu-efi/Makefile
@@ -7,7 +7,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=gnu-efi
 PKG_VERSION:=3.0.17
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL:=https://github.com/vathpela/gnu-efi.git
@@ -19,6 +19,8 @@ PKG_BUILD_PARALLEL:=1
 PKG_MAINTAINER:=Oskari Rauta <oskari.rauta@gmail.com>
 PKG_LICENSE_FILES:=README.efilib
 
+PKG_DT_RELR:=0
+
 include $(INCLUDE_DIR)/package.mk
 
 define Package/gnu-efi
diff --git a/libs/gnu-efi/patches/001-fix-objcopy-output-target.patch b/libs/gnu-efi/patches/001-fix-objcopy-output-target.patch
new file mode 100644
index 0000000000000..2daea5bb5d351
--- /dev/null
+++ b/libs/gnu-efi/patches/001-fix-objcopy-output-target.patch
@@ -0,0 +1,18 @@
+--- a/Make.rules
++++ b/Make.rules
+@@ -39,13 +39,13 @@
+ %.efi: %.so
+ 	$(OBJCOPY) -j .text -j .sdata -j .data -j .dynamic -j .dynsym -j .rel \
+ 		    -j .rela -j .rel.* -j .rela.* -j .rel* -j .rela* \
+-		    -j .reloc $(FORMAT) $*.so $@
++		    -j .reloc --output-target efi-app-$(ARCH) $*.so $@
+ 
+ %.efi.debug: %.so
+ 	$(OBJCOPY) -j .debug_info -j .debug_abbrev -j .debug_aranges \
+ 		-j .debug_line -j .debug_str -j .debug_ranges \
+ 		-j .note.gnu.build-id \
+-		$(FORMAT) $*.so $@
++		--output-target efi-app-$(ARCH) $*.so $@
+ 
+ %.so: %.o
+ 	$(LD) $(LDFLAGS) $^ -o $@ $(LOADLIBES)

From 82c04789c52aa11fe7538b0b36c8f0ce630514ef Mon Sep 17 00:00:00 2001
From: Balsam CHIHI <balsam.chihi@moment.tech>
Date: Mon, 28 Sep 2026 11:44:06 +0200
Subject: [PATCH 2/2] gummiboot: fix build on modern toolchains

This resolves build failures on x86_64 targets caused by recent host
toolchain bumps in OpenWrt main:

1. Use PKG_DT_RELR:=0 to opt out of pack-relative relocations, preventing
   objcopy from failing to convert ELF shared objects to PE/COFF.
2. Update 015-gummiboot-aarch64-support.patch to replace the deprecated
   objcopy `--target=` flag with `--output-target=` to satisfy
   Binutils >= 2.38 strictness.

Signed-off-by: Balsam CHIHI <balsam.chihi@moment.tech>
---
 utils/gummiboot/Makefile                                    | 4 +++-
 utils/gummiboot/patches/015-gummiboot-aarch64-support.patch | 2 +-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/utils/gummiboot/Makefile b/utils/gummiboot/Makefile
index 5f2df43475fef..ebf96e1ada7a6 100644
--- a/utils/gummiboot/Makefile
+++ b/utils/gummiboot/Makefile
@@ -7,7 +7,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=gummiboot
 PKG_VERSION:=48.1
-PKG_RELEASE:=3
+PKG_RELEASE:=4
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:=https://dev.alpinelinux.org/archive/gummiboot/
@@ -20,6 +20,8 @@ PKG_BUILD_PARALLEL:=1
 PKG_FIXUP:=autoreconf
 PKG_INSTALL:=1
 
+PKG_DT_RELR:=0
+
 include $(INCLUDE_DIR)/package.mk
 
 define Package/gummiboot
diff --git a/utils/gummiboot/patches/015-gummiboot-aarch64-support.patch b/utils/gummiboot/patches/015-gummiboot-aarch64-support.patch
index 84e3ee9a08364..e67762f2dc386 100644
--- a/utils/gummiboot/patches/015-gummiboot-aarch64-support.patch
+++ b/utils/gummiboot/patches/015-gummiboot-aarch64-support.patch
@@ -53,7 +53,7 @@ Signed-off-by: Koen Kooi <koen.kooi at linaro.org>
 +
 +FORMAT = -O binary
 +else
-+FORMAT = --target=efi-app-$(ARCH)
++FORMAT = --output-target=efi-app-$(ARCH)
 +endif
 +
 +
